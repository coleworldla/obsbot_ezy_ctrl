{
  "name": "obsbot-ezy-ctrl",
  "version": "0.8.7",
  "license": "MIT",
  "description": "Easy MIDI/OSC-mappable controller with live viewport and unlimited presets for OBSBOT Tail 2 cameras",
  "main": "./out/main/index.js",
  "private": true,
  "author": "coleworldla",
  "homepage": "https://github.com/coleworldla/obsbot_ezy_ctrl",
  "repository": {
    "type": "git",
    "url": "https://github.com/coleworldla/obsbot_ezy_ctrl.git"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "dist": "electron-vite build && electron-builder --win --publish never",
    "dist:dir": "electron-vite build && electron-builder --win --dir",
    "dist:mac": "electron-vite build && node scripts/fetch-ffmpeg.mjs mac arm64 x64 && electron-builder --mac --arm64 --x64 --publish never -c.mac.identity=-",
    "fake-camera": "node scripts/fake-tail2.mjs",
    "diagnose": "node scripts/diagnose.mjs",
    "ndi-probe": "node scripts/ndi-probe.mjs",
    "osc-send": "node scripts/osc-send.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^33.2.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^2.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "ffmpeg-static": "^5.3.0",
    "koffi": "^3.3.0"
  },
  "build": {
    "appId": "com.coleworldla.ezyctrl",
    "productName": "EZY CTRL",
    "copyright": "Copyright © 2026 coleworldla",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "**/node_modules/ffmpeg-static/**",
      "**/node_modules/koffi/**"
    ],
    "publish": {
      "provider": "github",
      "owner": "coleworldla",
      "repo": "obsbot_ezy_ctrl"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "shortcutName": "EZY CTRL",
      "artifactName": "EZY-CTRL-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "EZY-CTRL-${version}-portable.${ext}"
    },
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.video",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "artifactName": "EZY-CTRL-${version}-${arch}.${ext}",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "files": [
        "!node_modules/ffmpeg-static/ffmpeg"
      ],
      "extraResources": [
        {
          "from": "build/ffmpeg/mac-${arch}",
          "to": "ffmpeg",
          "filter": [
            "**/*"
          ]
        }
      ],
      "extendInfo": {
        "NSLocalNetworkUsageDescription": "EZY CTRL controls your cameras over VISCA and receives NDI video on the local network.",
        "NSBonjourServices": [
          "_ndi._tcp"
        ],
        "NSCameraUsageDescription": "Only used when you pick the Webcam video source.",
        "NSMicrophoneUsageDescription": "Not used; macOS requires this text for the webcam picker."
      }
    },
    "dmg": {
      "artifactName": "EZY-CTRL-${version}-${arch}.${ext}"
    }
  }
}
